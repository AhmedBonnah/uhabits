<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glassmorphism_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:elevation="0dp">

    <ImageView
        android:id="@+id/drag_handle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone"
        app:tint="?attr/colorControlNormal"
        tools:visibility="visible" />

    <org.isoron.uhabits.activities.common.views.RingView
        android:id="@+id/score_ring"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="12dp" />

    <ImageView
        android:id="@+id/group_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_folder"
        app:tint="?attr/colorControlNormal"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/group_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Morning Routine" />

    <org.isoron.uhabits.activities.habits.list.views.AddButtonView
        android:id="@+id/add_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" />

    <org.isoron.uhabits.activities.habits.list.views.CollapseButtonView
        android:id="@+id/collapse_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
